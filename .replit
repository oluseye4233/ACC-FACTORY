modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 21731
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
STRIPE_PRICE_PRACTITIONER_MONTHLY = "price_1TYGhf4vTID2utsVB9CtsYrn"
STRIPE_PRICE_PRACTITIONER_YEARLY = "price_1TYGhf4vTID2utsVrxQ8PC6L"
STRIPE_PRICE_ARCHITECT_MONTHLY = "price_1TYGhg4vTID2utsV9PJNbk4r"
STRIPE_PRICE_ARCHITECT_YEARLY = "price_1TYGhg4vTID2utsVN6PLnFCn"
